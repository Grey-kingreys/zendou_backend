NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://zendou:zendou@localhost:5433/zendou
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGIN=http://localhost:3000

# ─── Limitation de débit ───
# Nombre de proxys inverses devant l'app (Dokploy/Traefik en pose un).
# Détermine l'IP retenue dans X-Forwarded-For. 0 = aucun proxy, l'en-tête est
# ignoré. Mal réglé, tous les clients partagent un seul compteur.
TRUST_PROXY_HOPS=1
# Limites (requêtes par fenêtre). Vides = valeurs par défaut du code
# (src/rate-limit/rate-limit.constants.ts). /health n'est jamais compté.
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_HOUR=20
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_CHANGE_PASSWORD_PER_HOUR=5
RATE_LIMIT_EMAILS_PER_MINUTE=60
RATE_LIMIT_DOMAIN_CHECK_PER_HOUR=10
RATE_LIMIT_DNS_CHECK_PER_HOUR=30
RATE_LIMIT_SNS_PER_MINUTE=300
# Renvoi du lien de confirmation (POST /v1/auth/resend-confirmation), compté
# par utilisateur. Protège la boîte du titulaire de l'adresse : quelqu'un peut
# inscrire un compte avec l'email d'un tiers, s'y connecter, puis marteler le
# renvoi. 3/heure couvre un vrai besoin sans offrir un robinet.
RATE_LIMIT_RESEND_CONFIRMATION_PER_HOUR=3

# Verrouillage progressif de la connexion, par adresse email visée. La
# limitation ci-dessus borne le rythme des tentatives ; celui-ci borne
# l'acharnement sur un compte donné, quelle que soit l'IP d'origine (un
# attaquant qui change d'IP à chaque salve reste sinon sous le seuil).
# Échecs consécutifs tolérés avant blocage.
LOGIN_LOCKOUT_THRESHOLD=5
# Durée du premier blocage, en secondes. Elle double à chaque palier atteint
# (60 s, 120 s, 240 s...).
LOGIN_LOCKOUT_BASE_SECONDS=60
# Plafond du doublement, en secondes (une heure). Au-delà, le verrouillage
# punirait le titulaire du compte : n'importe qui peut faire échouer des
# connexions sur l'adresse d'un tiers.
LOGIN_LOCKOUT_MAX_SECONDS=3600
# Durée de vie du compteur d'échecs, en secondes : cinq fautes de frappe
# étalées sur la journée ne doivent rien déclencher.
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# ─── AWS SES — envoi via API v2 (recommandé) ───
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# ─── AWS SES — option relais SMTP (si tu passes par SMTP au lieu de l'API) ───
SES_SMTP_HOST=
SES_SMTP_PORT=
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# ─── SNS — bounces / plaintes ───
SES_SNS_TOPIC_ARN=
# Ignore la vérification de signature du webhook SNS (tests locaux / démo).
# Refusé si NODE_ENV=production.
SNS_SKIP_SIGNATURE_VALIDATION=false

# ─── Captcha Cloudflare Turnstile (POST /v1/auth/register uniquement) ───
# Optionnelle : absente ou vide, le captcha est désactivé (dev, tests, et
# débrayage d'urgence en prod si le widget gêne des utilisateurs). La clé de
# site correspondante (publique) vit côté frontend :
# NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# ─── Compte admin (optionnel) ───
# Si ADMIN_EMAIL et ADMIN_PASSWORD sont renseignées, un compte administrateur
# est créé automatiquement au démarrage de l'app s'il n'existe pas déjà
# (aucune intervention manuelle nécessaire après un déploiement). Les deux
# doivent être fournies ensemble, ou aucune des deux. ADMIN_PASSWORD doit
# faire au moins 12 caractères. Ne jamais commiter de vraies valeurs ici.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ─── Alertes d'exploitation (optionnel) ───
# Destinataire des alertes techniques — aujourd'hui l'expiration du
# certificat TLS du relais SMTP, dont le renouvellement est manuel tous les
# 90 jours. Vide, on retombe sur ADMIN_EMAIL ; vides toutes les deux, les
# alertes sont seulement journalisées et le démarrage l'annonce. L'adresse
# doit correspondre à un compte Zendou existant.
ALERTS_EMAIL_TO=

# ─── Emails système (confirmation d'adresse) ───
# Adresse d'expédition de TOUS les emails envoyés par Zendou lui-même.
# Accepte une adresse nue (adresse@domaine) ou avec nom d'affichage
# (Nom <adresse@domaine>), par exemple : Zendou <no-reply@mail.kingreys.fr>
# OBLIGATOIRE quand NODE_ENV=production : sans elle, l'application refuse de
# démarrer — un tunnel d'inscription qui ne peut confirmer aucun compte est
# pire qu'un démarrage bloqué. En dev/test, l'absence est tolérée (rien n'est
# expédié).
# Son domaine doit être vérifié chez SES ET présent dans la table Domain de
# Zendou avec le statut VERIFIED : l'exemption des envois système ne relâche
# pas cette exigence. En bêta : mail.kingreys.fr, seul domaine vérifié.
SYSTEM_EMAIL_FROM=
# Base des liens contenus dans ces emails : ${APP_BASE_URL}/confirmation?token=…
# Vide = repli sur FRONTEND_ORIGIN, ce qui convient dans la quasi-totalité des
# déploiements. À renseigner seulement si le domaine applicatif diffère de
# l'origine du front.
APP_BASE_URL=
# Crédits offerts une seule fois, au moment de la confirmation de l'adresse —
# jamais à l'inscription (sinon créer des comptes deviendrait une capacité de
# spam gratuite sur notre compte SES). Vide = 1000. 0 désactive le bonus.
WELCOME_CREDITS=1000

# ─── Adresse d'expédition de test (bac à sable, façon Resend — B20) ───
# Permet à un client fraîchement inscrit d'envoyer IMMÉDIATEMENT, avant même
# d'avoir vérifié un domaine (comme onboarding@resend.dev chez Resend). Accepte
# une adresse nue ou avec nom d'affichage, comme SYSTEM_EMAIL_FROM, par
# exemple : Zendou (essai) <essai@mail.kingreys.fr>
# En contrepartie, EmailsService restreint le DESTINATAIRE à la seule adresse
# du compte appelant (user.email, déjà confirmée) — sinon 403. Ce n'est pas
# une limite arbitraire : c'est ce qui protège la réputation de ce domaine
# d'expédition partagé, qui est aussi celui de SYSTEM_EMAIL_FROM et expédie
# donc les confirmations d'inscription. Sans cette restriction, ce mode
# deviendrait un relais d'envoi anonyme vers n'importe quelle adresse.
# Optionnelle PARTOUT, y compris en production : absente, ce mode est
# simplement indisponible et tout envoi retombe sur l'exigence normale de
# domaine vérifié et possédé par le client — aucune régression possible.
TEST_EMAIL_FROM=

# ─── Relais SMTP entrant (B6 — voir docs/plans/B6-RELAIS-SMTP.md) ───
# Interrupteur général. FAUX par défaut : module inerte partout, production
# comprise — aucun port ouvert, aucun fichier lu, tant que cette variable
# n'est pas explicitement activée.
SMTP_RELAY_ENABLED=false
# Ports écoutés en STARTTLS, séparés par des virgules. 587 (soumission
# standard) + 2525 (repli gratuit si un FAI filtre 587). Jamais 25 (transit
# MX, pas soumission). Vide = aucune écoute STARTTLS.
SMTP_PORTS_STARTTLS=587,2525
# Ports écoutés en TLS implicite (RFC 8314). Vide = aucune écoute TLS
# implicite — mais SMTP_PORTS_STARTTLS et SMTP_PORTS_TLS ne peuvent pas être
# vides toutes les deux quand le relais est activé (l'app refuse de démarrer).
SMTP_PORTS_TLS=465
# Interface d'écoute. Toutes par défaut — sous Dokploy c'est la publication de
# port en mode host qui décide de l'exposition.
SMTP_BIND_ADDRESS=0.0.0.0
# Chemins du certificat et de la clé privée (fichiers montés en lecture
# seule, produits par certbot/lego sur l'hôte). OBLIGATOIRES quand
# NODE_ENV=production et SMTP_RELAY_ENABLED=true : l'app refuse de démarrer
# sans eux, un serveur de soumission ne sert jamais en clair. Absents hors
# production, smtp-server sert son certificat auto-signé intégré (dev
# uniquement). Ne jamais commiter de vraies valeurs ici.
SMTP_TLS_CERT_PATH=
SMTP_TLS_KEY_PATH=
# Connexions simultanées par instance SMTPServer — protège l'event loop
# partagé avec l'API.
SMTP_MAX_CLIENTS=50
# Inactivité tolérée sur une connexion avant fermeture.
SMTP_SOCKET_TIMEOUT_MS=60000
# Sursis accordé aux connexions en cours lors d'un arrêt gracieux (SIGTERM).
SMTP_CLOSE_TIMEOUT_MS=15000

# ─── Pipeline du relais SMTP (B6/S7) ───
# Taille maximale d'un message MIME reçu, en octets. Annoncée par la
# capacité SIZE de l'EHLO et appliquée pendant le flux DATA. Défaut : 10 Mo.
SMTP_MAX_MESSAGE_BYTES=10485760
# Destinataires acceptés pour un même message (éventail plafonné, B7). Le
# destinataire en trop reçoit 452 sur son RCPT TO. Chaque destinataire
# facture un crédit, comme un appel API.
SMTP_MAX_RECIPIENTS=10

# ─── Anti-abus du relais SMTP (B6/S9) ───
# Limites par IP (connexions, échecs d'authentification) actives ? VRAIE par
# défaut — c'est une protection, on ne l'éteint pas par omission. À passer à
# false UNIQUEMENT si l'IP source n'arrive pas intacte jusqu'au processus
# (routing mesh Docker Swarm en mode ingress, §1.3 du plan) : sinon les
# limites par IP s'effondrent en un compteur unique partagé par tout
# Internet, pire qu'une limite absente.
SMTP_IP_LIMITS_ENABLED=true
# Connexions acceptées depuis une même IP par SMTP_CONNECTION_WINDOW_MS.
SMTP_MAX_CONNECTIONS_PER_IP=30
# Fenêtre du compteur de connexions par IP (une minute).
SMTP_CONNECTION_WINDOW_MS=60000
# Échecs d'authentification tolérés sur une même connexion ; le suivant
# reçoit 421 et voit son socket fermé.
SMTP_MAX_AUTH_FAILURES_PER_CONNECTION=3
# Fenêtre des compteurs d'échecs d'AUTH par IP et par nom d'utilisateur
# (quinze minutes). Alimentent l'observation, ne bloquent rien.
SMTP_AUTH_FAILURE_WINDOW_MS=900000
# Noms d'utilisateur distincts ratés par une même IP, dans la fenêtre
# ci-dessus, avant la ligne d'alerte « bourrinage d'identifiants ».
SMTP_AUTH_STUFFING_USERNAME_THRESHOLD=3
# Protection de rafale du canal SMTP, comptée PAR UTILISATEUR (jamais par IP
# — NAT opérateur en Guinée). Budget séparé de RATE_LIMIT_EMAILS_PER_MINUTE,
# même valeur par défaut.
SMTP_EMAILS_PER_MINUTE=60
# Messages acceptés sur une même connexion avant 421 + fermeture.
SMTP_MAX_MESSAGES_PER_CONNECTION=100
# Destinataires refusés tolérés sur une même connexion avant 421 + fermeture
# (anti-moissonnage d'adresses).
SMTP_MAX_REFUSED_RECIPIENTS_PER_CONNECTION=10
