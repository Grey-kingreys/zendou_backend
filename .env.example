NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://zendou:zendou@localhost:5433/zendou
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGIN=http://localhost:3000

# ─── Limitation de débit ───
# Nombre de proxys inverses devant l'app (Dokploy/Traefik en pose un).
# Détermine l'IP retenue dans X-Forwarded-For. 0 = aucun proxy, l'en-tête est
# ignoré. Mal réglé, tous les clients partagent un seul compteur.
TRUST_PROXY_HOPS=1
# Limites (requêtes par fenêtre). Vides = valeurs par défaut du code
# (src/rate-limit/rate-limit.constants.ts). /health n'est jamais compté.
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_HOUR=20
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_CHANGE_PASSWORD_PER_HOUR=5
RATE_LIMIT_EMAILS_PER_MINUTE=60
RATE_LIMIT_DOMAIN_CHECK_PER_HOUR=10
RATE_LIMIT_DNS_CHECK_PER_HOUR=30
RATE_LIMIT_SNS_PER_MINUTE=300

# ─── AWS SES — envoi via API v2 (recommandé) ───
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ─── AWS SES — option relais SMTP (si tu passes par SMTP au lieu de l'API) ───
SES_SMTP_HOST=
SES_SMTP_PORT=
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# ─── SNS — bounces / plaintes ───
SES_SNS_TOPIC_ARN=
# Ignore la vérification de signature du webhook SNS (tests locaux / démo).
# Refusé si NODE_ENV=production.
SNS_SKIP_SIGNATURE_VALIDATION=false

# ─── Captcha Cloudflare Turnstile (POST /v1/auth/register uniquement) ───
# Optionnelle : absente ou vide, le captcha est désactivé (dev, tests, et
# débrayage d'urgence en prod si le widget gêne des utilisateurs). La clé de
# site correspondante (publique) vit côté frontend :
# NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# ─── Compte admin (optionnel) ───
# Si ADMIN_EMAIL et ADMIN_PASSWORD sont renseignées, un compte administrateur
# est créé automatiquement au démarrage de l'app s'il n'existe pas déjà
# (aucune intervention manuelle nécessaire après un déploiement). Les deux
# doivent être fournies ensemble, ou aucune des deux. ADMIN_PASSWORD doit
# faire au moins 12 caractères. Ne jamais commiter de vraies valeurs ici.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
