// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
  TEMPORARY_FAILURE
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  REJECTED
  FAILED
  SUPPRESSED
}

enum SuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  name           String
  company        String?
  declaredUsage  String?
  status         UserStatus @default(ACTIVE)
  role           UserRole   @default(CUSTOMER)
  dailySendLimit Int        @default(200)

  /// Borne basse de la fenêtre de réputation, posée à chaque réactivation
  /// administrative : les événements antérieurs ne comptent plus. Sans elle,
  /// un compte réactivé traînerait ses 30 jours de mauvaises statistiques et
  /// serait re-suspendu au premier rebond suivant.
  reputationResetAt DateTime?
  suspendedAt       DateTime?
  suspensionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys       ApiKey[]
  domains       Domain[]
  emails        Email[]
  creditEntries CreditEntry[]
  topUpRequests TopUpRequest[]

  adminActionsPerformed AdminAction[] @relation("AdminActionsPerformed")
  adminActionsReceived  AdminAction[] @relation("AdminActionsReceived")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  name       String
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Domain {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  name       String       @unique
  status     DomainStatus @default(PENDING)
  dkimTokens String[]
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId])
}

model Email {
  id           String      @id @default(cuid())
  publicId     String      @unique
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  domainId     String?
  fromAddress  String
  toAddress    String
  subject      String
  status       EmailStatus @default(QUEUED)
  sesMessageId String?     @unique
  errorMessage String?
  queuedAt     DateTime    @default(now())
  sentAt       DateTime?
  deliveredAt  DateTime?
  lastEventAt  DateTime?

  @@index([userId, queuedAt])
  @@index([status])
}

model Suppression {
  id        String            @id @default(cuid())
  address   String
  reason    SuppressionReason
  userId    String?
  createdAt DateTime          @default(now())

  @@unique([address, userId])
  @@index([address])
}

model CreditEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  delta     Int
  reason    String
  reference String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TopUpMethod {
  ORANGE_MONEY
  MTN_MOMO
}

model TopUpRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  packId          String
  credits         Int
  amountGnf       Int
  method          TopUpMethod
  phoneNumber     String
  transactionRef  String
  status          TopUpStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

enum AdminActionType {
  SUSPEND_USER
  REACTIVATE_USER
  ADJUST_QUOTA
  GRANT_CREDITS
  PROMOTE_ADMIN
  DEMOTE_ADMIN
  APPROVE_TOPUP
  REJECT_TOPUP
}

/// Journal d'audit des actions administratives : qui a fait quoi, sur qui,
/// pourquoi. Append-only — jamais mis à jour ni supprimé.
model AdminAction {
  id           String          @id @default(cuid())
  adminId      String
  admin        User            @relation("AdminActionsPerformed", fields: [adminId], references: [id])
  targetUserId String?
  targetUser   User?           @relation("AdminActionsReceived", fields: [targetUserId], references: [id])
  type         AdminActionType
  reason       String?
  details      Json?
  createdAt    DateTime        @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}
