// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
  TEMPORARY_FAILURE
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  REJECTED
  FAILED
  SUPPRESSED
}

enum SuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  /// Empreinte argon2id du mot de passe. `null` pour un compte qui n'a pas de
  /// mot de passe : créé par « Continuer avec Google », ou rattaché à Google
  /// alors qu'il n'était pas confirmé (mot de passe effacé, voir B30).
  passwordHash   String?
  name           String
  company        String?
  declaredUsage  String?
  status         UserStatus @default(ACTIVE)
  role           UserRole   @default(CUSTOMER)
  dailySendLimit Int        @default(200)

  /// Borne basse de la fenêtre de réputation, posée à chaque réactivation
  /// administrative : les événements antérieurs ne comptent plus. Sans elle,
  /// un compte réactivé traînerait ses 30 jours de mauvaises statistiques et
  /// serait re-suspendu au premier rebond suivant.
  reputationResetAt DateTime?
  suspendedAt       DateTime?
  suspensionReason  String?

  /// Date de confirmation de l'adresse email. `null` = compte non confirmé :
  /// il peut se connecter, mais ne peut ni envoyer d'email ni créer de clé API
  /// (voir `EmailVerifiedGuard`). Les comptes antérieurs à la migration ont
  /// été rétro-confirmés (`emailVerifiedAt = createdAt`) : voir le commentaire
  /// de la migration `email_confirmation`.
  emailVerifiedAt DateTime?

  /// Empreinte SHA-256 (hex) du jeton de confirmation — **jamais le jeton en
  /// clair**, exactement comme `ApiKey.keyHash`. Écrasée à chaque renvoi :
  /// un seul jeton vivant à la fois. Conservée après confirmation pour que
  /// un rejeu du lien réponde 409 « déjà confirmé » plutôt qu'un 400 trompeur
  /// — elle est alors inerte, `emailVerifiedAt` verrouillant tout.
  emailVerificationTokenHash String? @unique

  /// Adresse à laquelle le jeton courant a été expédié. Le jeton n'est
  /// accepté que si elle est encore l'adresse du compte : **toute**
  /// modification de `email`, d'où qu'elle vienne, invalide donc le jeton
  /// sans que le code qui change l'adresse ait à y penser.
  emailVerificationSentTo String?

  /// Expiration du jeton courant (voir `EMAIL_CONFIRMATION_TTL_HOURS`).
  emailVerificationExpiresAt DateTime?

  /// Date d'octroi du crédit de bienvenue. Sert de verrou « une seule fois par
  /// compte » : le crédit n'est écrit que par la transaction qui réussit à
  /// passer cette colonne de `null` à une date.
  welcomeCreditsGrantedAt DateTime?

  /// Identifiant Google stable (claim `sub` de l'`id_token`, B30). `null` tant
  /// que le compte n'est pas rattaché à Google. Unique : un compte Google ne
  /// peut ouvrir qu'un seul compte Zendou.
  googleSub String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys         ApiKey[]
  smtpCredentials SmtpCredential[]
  domains         Domain[]
  emails          Email[]
  creditEntries   CreditEntry[]
  topUpRequests   TopUpRequest[]

  adminActionsPerformed AdminAction[] @relation("AdminActionsPerformed")
  adminActionsReceived  AdminAction[] @relation("AdminActionsReceived")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  name       String
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Identifiants d'authentification du relais SMTP (B6), distincts des
/// `ApiKey` : un secret `zd_smtp_…` collé dans un `wp-config.php` ou un
/// `.env` d'ERP tiers doit pouvoir être révoqué sans casser les intégrations
/// API du même compte. Cycle de vie calqué ligne à ligne sur `ApiKey`.
model SmtpCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  name   String

  /// Identifiant opaque et généré (ex. `zdu_` + 16 hex), jamais l'adresse
  /// email du compte : il finit dans des fichiers de config tiers et sert au
  /// lookup d'authentification SMTP (`AUTH PLAIN`/`AUTH LOGIN`).
  username String @unique

  /// 12 premiers caractères du secret `zd_smtp_…`, affichés dans l'UI pour
  /// distinguer les identifiants sans jamais réafficher le secret complet —
  /// même rôle que `ApiKey.prefix`.
  prefix String

  /// SHA-256 (hex) du secret présenté à `AUTH` — jamais le secret en clair,
  /// même mécanique que `ApiKey.keyHash` (`hashApiKey`, réutilisée telle
  /// quelle).
  secretHash String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())

  emails Email[]

  @@index([userId])
}

model Domain {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  name       String       @unique
  status     DomainStatus @default(PENDING)
  dkimTokens String[]
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId])
}

enum EmailChannel {
  API
  SMTP
}

model Email {
  id           String      @id @default(cuid())
  publicId     String      @unique
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  domainId     String?
  fromAddress  String
  toAddress    String
  subject      String
  status       EmailStatus @default(QUEUED)
  sesMessageId String?     @unique
  errorMessage String?
  queuedAt     DateTime    @default(now())
  sentAt       DateTime?
  deliveredAt  DateTime?
  lastEventAt  DateTime?

  /// Canal d'entrée de l'envoi (B6) : `API` pour `POST /v1/emails`, `SMTP`
  /// pour le relais SMTP. Colonne additive avec défaut — n'affecte aucune
  /// ligne existante.
  channel EmailChannel @default(API)

  /// Identifiant SMTP ayant expédié cet envoi (canal SMTP uniquement) —
  /// traçabilité « quel identifiant a envoyé quoi ». `null` pour le canal API.
  smtpCredentialId String?

  /// `onDelete: SetNull`, volontairement : la suppression d'un identifiant
  /// SMTP (révocation, purge) ne doit jamais entraîner la suppression des
  /// lignes `Email` déjà journalisées — le journal d'envoi est append-only et
  /// doit survivre à la suppression de l'identifiant qui l'a produit.
  smtpCredential SmtpCredential? @relation(fields: [smtpCredentialId], references: [id], onDelete: SetNull)

  /// Envoi émis par Zendou lui-même (confirmation d'adresse…) et non par le
  /// client. `userId` désigne alors le **destinataire**, pas l'expéditeur.
  /// Ces lignes sont volontairement exclues de tout ce qui mesure « ce que ce
  /// client a envoyé » : métrique de réputation, quota journalier, journal des
  /// envois, KPI admin. Voir `EmailsService.sendSystem` pour la liste exacte
  /// de ce que l'exemption couvre — et de ce qu'elle ne couvre pas.
  system Boolean @default(false)

  @@index([userId, queuedAt])
  @@index([status])
  /// Sert les fenêtres glissantes (aujourd'hui / 7 j / 30 j) de
  /// `GET /v1/admin/stats/emails`, qui filtrent par `queuedAt`
  /// toutes-comptes confondues : `@@index([userId, queuedAt])` ne peut pas
  /// servir ce filtre (aucune de ces requêtes ne connaît de `userId`), il
  /// forcerait un balayage complet de la table, de plus en plus lent à
  /// mesure que la plateforme envoie.
  @@index([queuedAt])
}

model Suppression {
  id        String            @id @default(cuid())
  address   String
  reason    SuppressionReason
  userId    String?
  createdAt DateTime          @default(now())

  @@unique([address, userId])
  @@index([address])
}

model CreditEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  delta     Int
  reason    String
  reference String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TopUpMethod {
  ORANGE_MONEY
  MTN_MOMO
}

model TopUpRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  packId          String
  credits         Int
  amountGnf       Int
  method          TopUpMethod
  phoneNumber     String
  transactionRef  String
  status          TopUpStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

enum AdminActionType {
  SUSPEND_USER
  REACTIVATE_USER
  ADJUST_QUOTA
  GRANT_CREDITS
  PROMOTE_ADMIN
  DEMOTE_ADMIN
  APPROVE_TOPUP
  REJECT_TOPUP
  DELETE_USER
}

/// Journal d'audit des actions administratives : qui a fait quoi, sur qui,
/// pourquoi. Append-only — jamais mis à jour ni supprimé.
model AdminAction {
  id           String          @id @default(cuid())
  adminId      String
  admin        User            @relation("AdminActionsPerformed", fields: [adminId], references: [id])
  targetUserId String?
  targetUser   User?           @relation("AdminActionsReceived", fields: [targetUserId], references: [id])
  type         AdminActionType
  reason       String?
  details      Json?
  createdAt    DateTime        @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}
